# 运行环境变量（实际值放在服务器的环境文件里，不进仓库）

# 子目录部署：构建和运行都要设置；正式域名用根路径时设为 /
NUXT_APP_BASE_URL=/aura-institute/

# canonical、站点地图、结构化数据使用的站点地址
NUXT_PUBLIC_SITE_URL=https://example.com

# staging（整站 noindex）/ production（允许收录）
NUXT_PUBLIC_DEPLOY_ENV=staging

# 浏览器端接口基址：同源反代（<站点前缀>/api）
NUXT_PUBLIC_API_BASE=/aura-institute/api

# 服务端渲染直连 Vectra 公开接口的内网基址与 Host 头（留空则回退到 NUXT_PUBLIC_API_BASE）
NUXT_API_BASE_SERVER=
NUXT_API_HOST_HEADER=

# 与 Vectra 后端「内部密钥」里该部署的 revalidate 密钥相同；留空则 /_site/revalidate 不存在
NUXT_REVALIDATE_SECRET=

# 允许内嵌本站做可视化编辑预览的 Vectra 网址（逗号分隔）；留空则不开放
NUXT_PUBLIC_CMS_ORIGINS=
